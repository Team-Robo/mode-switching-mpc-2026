<launch>
    <!--
    deploy_sac.launch
    =================
    Deploys the trained SAC weight tuner alongside the MPC navigation stack.

    The weight_tuner_node runs in "bridge" mode by default (receives weights
    from a lightweight Python inference node) or "onnx" mode (runs ONNX actor
    directly in C++ — requires building with -DUSE_ONNX_RUNTIME=ON).

    Usage:
        roslaunch teamrobo2026 deploy_sac.launch
        roslaunch teamrobo2026 deploy_sac.launch mode:=onnx onnx_model:=rl/models/sac_mpc_actor.onnx
    -->

    <!-- ── Arguments ──────────────────────────────────────────────────── -->
    <arg name="mode"        default="bridge" doc="bridge | onnx" />
    <arg name="onnx_model"  default="$(find teamrobo2026)/rl/models/sac_mpc_actor.onnx" />
    <arg name="update_rate" default="1.0"  doc="Weight update frequency (Hz)" />
    <arg name="mpc_verbose" default="true" />

    <!-- Goal offsets (relative to init pose, matching run.py) -->
    <arg name="goal_x"  default="0" />
    <arg name="goal_y"  default="10" />
    <arg name="init_x"  default="-2.25" />
    <arg name="init_y"  default="3" />

    <!-- ── Include base MPC navigation stack ──────────────────────────── -->
    <include file="$(find teamrobo2026)/launch/move_base_mlda_2026.launch" />

    <!-- ── Enable MPC verbose logging ─────────────────────────────────── -->
    <param name="/teamrobo2026/mpc_verbose" value="$(arg mpc_verbose)" />

    <!-- ── SAC Weight Tuner Node (C++) ────────────────────────────────── -->
    <node pkg="teamrobo2026" type="weight_tuner_node" name="weight_tuner"
          output="screen">
        <param name="mode"            value="$(arg mode)" />
        <param name="onnx_model_path" value="$(arg onnx_model)" />
        <param name="update_rate"     value="$(arg update_rate)" />
        <param name="goal_x"          value="$(arg goal_x)" />
        <param name="goal_y"          value="$(arg goal_y)" />
        <param name="init_x"          value="$(arg init_x)" />
        <param name="init_y"          value="$(arg init_y)" />
    </node>
</launch>
